<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.github.vcth4nh.idesense</id>
    <name>IdeSense - IDE MCP Server</name>
    <vendor email="idesense@thanh.vc" url="https://github.com/vcth4nh">vcth4nh</vendor>
    <!-- The description is not here: the build takes it from README.md (the block between the "Plugin description" markers, see pluginConfiguration in build.gradle.kts). -->

    <!-- Rider exclusion - plugin uses IntelliJ PSI APIs not compatible with Rider's ReSharper backend -->
    <incompatible-with>com.intellij.modules.rider</incompatible-with>

    <!-- Platform dependency (required) -->
    <depends>com.intellij.modules.platform</depends>

    <!-- Optional Java support -->
    <depends optional="true" config-file="java-features.xml">com.intellij.modules.java</depends>

    <!-- Optional Kotlin support -->
    <depends optional="true" config-file="kotlin-features.xml">org.jetbrains.kotlin</depends>

    <!-- Optional Python support (PyCharm, IntelliJ Ultimate with Python plugin) -->
    <depends optional="true" config-file="python-features.xml">com.intellij.modules.python</depends>

    <!-- Optional JavaScript support (WebStorm, IntelliJ Ultimate with JS plugin) -->
    <depends optional="true" config-file="javascript-features.xml">JavaScript</depends>

    <!-- Optional Go support (GoLand, IntelliJ Ultimate with Go plugin) -->
    <depends optional="true" config-file="go-features.xml">org.jetbrains.plugins.go</depends>

    <!-- Optional PHP support (PhpStorm, IntelliJ Ultimate with PHP plugin) -->
    <depends optional="true" config-file="php-features.xml">com.jetbrains.php</depends>

    <!-- Optional Rust support (RustRover, IntelliJ Ultimate with Rust plugin, CLion) -->
    <depends optional="true" config-file="rust-features.xml">com.jetbrains.rust</depends>

    <resource-bundle>messages.McpBundle</resource-bundle>

    <!-- Declare Kotlin K1/K2 plugin mode compatibility -->
    <extensions defaultExtensionNs="org.jetbrains.kotlin">
        <supportsKotlinPluginMode supportsK2="true"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Application-level MCP Server Service -->
        <applicationService serviceImplementation="com.github.vcth4nh.idesense.server.McpServerService"/>

        <!-- Project-level Command History Service -->
        <projectService serviceImplementation="com.github.vcth4nh.idesense.history.CommandHistoryService"/>

        <!-- Project-level Build Diagnostics Cache Service -->
        <projectService serviceImplementation="com.github.vcth4nh.idesense.server.BuildDiagnosticsCacheService"/>

        <!-- Project-level diagnostics analysis service -->
        <projectService serviceImplementation="com.github.vcth4nh.idesense.tools.intelligence.DiagnosticsAnalysisService"/>

        <!-- Tool Window -->
        <toolWindow id="IdeSense" anchor="bottom" icon="com.github.vcth4nh.idesense.icons.McpIcons.ToolWindow" factoryClass="com.github.vcth4nh.idesense.ui.McpToolWindowFactory"/>

        <!-- Settings -->
        <applicationService serviceImplementation="com.github.vcth4nh.idesense.settings.McpSettings"/>
        <applicationConfigurable id="mcp.settings" displayName="IdeSense" instance="com.github.vcth4nh.idesense.settings.McpSettingsConfigurable"/>

        <!-- Startup Activity -->
        <postStartupActivity implementation="com.github.vcth4nh.idesense.startup.McpServerStartupActivity"/>

        <!-- Notification Group -->
        <notificationGroup id="IdeSense" displayType="BALLOON"/>
    </extensions>

    <!-- Extension Points -->
    <extensionPoints>
        <extensionPoint name="mcpTool"
                        interface="com.github.vcth4nh.idesense.tools.McpTool"
                        dynamic="true"/>
        <extensionPoint name="languageKindResolver"
                        beanClass="com.intellij.lang.LanguageExtensionPoint">
            <with attribute="implementationClass"
                  implements="com.github.vcth4nh.idesense.handlers.LanguageKindResolver"/>
        </extensionPoint>
        <extensionPoint name="superMethodsProvider"
                        beanClass="com.intellij.lang.LanguageExtensionPoint">
            <with attribute="implementationClass"
                  implements="com.github.vcth4nh.idesense.handlers.SuperMethodsProvider"/>
        </extensionPoint>
    </extensionPoints>

    <actions>
        <group id="McpServer.Actions" text="IdeSense">
            <action id="McpServer.CopyUrl" class="com.github.vcth4nh.idesense.actions.CopyServerUrlAction" text="Copy Server URL" description="Copy the MCP server URL to clipboard"/>
            <action id="McpServer.CopyConfig" class="com.github.vcth4nh.idesense.actions.CopyClientConfigAction" text="Copy Client Config..." description="Copy MCP client configuration for AI assistants"/>
            <action id="McpServer.ClearHistory" class="com.github.vcth4nh.idesense.actions.ClearHistoryAction" text="Clear History" description="Clear command history"/>
            <action id="McpServer.ExportHistory" class="com.github.vcth4nh.idesense.actions.ExportHistoryAction" text="Export History..." description="Export command history to file"/>
            <action id="McpServer.InstallSkill" class="com.github.vcth4nh.idesense.actions.InstallSkillAction" text="Get Companion Skill" description="Install or export the companion skill for AI coding agents"/>
            <action id="McpServer.OpenSettings" class="com.github.vcth4nh.idesense.actions.OpenSettingsAction" text="Settings" description="Open MCP Server settings"/>
        </group>
    </actions>
</idea-plugin>
